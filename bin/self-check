#!/bin/bash

# http://www.gnu.org/software/bash/manual/bash.html#The-Set-Builtin
# http://redsymbol.net/articles/unofficial-bash-strict-mode
set -o nounset -o errexit -o pipefail

script=`realpath $0`
scriptdir=`dirname $script`
scriptname=`basename $script`

RED="\e[31m" GREEN="\e[32m" RESET="\e[0m"

EXIT_MESSAGE="${RED}bin/self-check failed${RESET}"

# http://redsymbol.net/articles/bash-exit-traps/
trap 'echo -e "$EXIT_MESSAGE"' EXIT
cd $scriptdir/..

# Each probe runs in its own strict shell; its lines carry its name.
(
    set -o nounset -o errexit -o pipefail
    version=`node --version`
    if ! printf '%s\n' v22.13.0 $version | sort -V -C; then
        echo "$version: 22.13.0 or later is needed"
        exit 1
    fi
    echo $version
) 2>&1 | sed 's/^/[node] /'

(
    set -o nounset -o errexit -o pipefail
    file=`node -p 'require("playwright").chromium.executablePath()'`
    if [ ! -x "$file" ]; then
        echo "$file: missing, run bin/configure"
        exit 1
    fi
    echo $file
) 2>&1 | sed 's/^/[chromium] /'

(
    set -o nounset -o errexit -o pipefail
    for page in docs/rules.html docs/animations.html docs/glossaries.html docs/agents.html docs/diagrams.html; do
        if [ ! -s $page ]; then
            echo "$page: missing, run bin/build"
            exit 1
        fi
        echo "$page: present"
    done
) 2>&1 | sed 's/^/[pages] /'

EXIT_MESSAGE="${GREEN}bin/self-check succeeded${RESET}"
