#!/usr/bin/env node

const cli = require('@vbarbarosh/node-helpers/src/cli');
const fs = require('node:fs');
const path = require('node:path');

const blob_url = 'https://github.com/vbarbarosh/rules/blob/main/';
const class_by_marker = {'//': 'cmt', '&lt;!--': 'cmt', '✓': 'yes', '✗': 'no', '←': 'aside'};
const docs_dir = path.join(__dirname, '..', 'docs');
const glossary_files = ['glossaries/agents.md', 'glossaries/testing.md', 'glossaries/doc.md'];
const marker_regex = /(^|\s)(\/\/|&lt;!--|✓|✗|←)/;
const root_dir = path.join(__dirname, '..');

cli(main);

function main()
{
    build_rules_html();
    build_glossaries_html();
}

function build_rules_html()
{
    const markdown = fs.readFileSync(path.join(docs_dir, 'rules.md'), 'utf8');
    const template = fs.readFileSync(path.join(docs_dir, 'rules.template.html'), 'utf8');
    const index = index_from_markdown(markdown);
    index_assert_counts(index);
    fs.writeFileSync(path.join(docs_dir, 'rules.html'), html_from_index(template, index));
}

function build_glossaries_html()
{
    const template = fs.readFileSync(path.join(docs_dir, 'glossaries.template.html'), 'utf8');
    const glossaries = [];
    for (const file of glossary_files) {
        glossaries.push(glossary_from_markdown(fs.readFileSync(path.join(root_dir, file), 'utf8'), file));
    }
    fs.writeFileSync(path.join(docs_dir, 'glossaries.html'), html_from_glossaries(template, glossaries));
}

// rules.md: a title, a lede, a stats line, the group table, the rule table.
function index_from_markdown(markdown)
{
    const lines = markdown.split('\n');
    const lede_end = lines.indexOf('', 2);
    const stats = lines.find(v => /^\d+ rules · \d+ groups · \d+ sources/.test(v)).match(/^(\d+) rules · (\d+) groups · (\d+) sources/);
    const out = {
        title: lines[0].replace(/^# /, ''),
        lede: lines.slice(2, lede_end).join(' '),
        stated: {rules: Number(stats[1]), groups: Number(stats[2]), sources: Number(stats[3])},
        groups: [],
    };
    const group_by_tag = {};
    let table = null;
    let group = null;
    for (const line of lines) {
        if (line.startsWith('| Tag | Group |')) {
            table = 'groups';
            continue;
        }
        if (line.startsWith('| Code | Rule |')) {
            table = 'rules';
            continue;
        }
        if (!line.startsWith('| ') || line.startsWith('|--')) {
            continue;
        }
        const cells = cells_from_row(line);
        if (table === 'groups') {
            const next = {tag: cells[0], name: cells[1], stated: Number(cells[2]), note: cells[3], rules: []};
            out.groups.push(next);
            group_by_tag[next.tag] = next;
        }
        else if (table === 'rules' && /^\*\*[A-Z]+\*\*$/.test(cells[0])) {
            group = group_by_tag[cells[0].slice(2, -2)];
            if (cells[1] !== `**${group.name}** — ${group.note}`) {
                throw new Error(`rules.md: the ${group.tag} header row does not match the group table: ${cells[1]}`);
            }
        }
        else if (table === 'rules') {
            const source = cells[3].match(/^\[(.+)\]\((.+)\)$/);
            group.rules.push({code: cells[0], text: cells[1], form: cells[2], source_label: source[1], source_path: path.posix.join('docs', source[2])});
        }
    }
    return out;
}

// The counts rules.md states by hand must match the rows it holds.
function index_assert_counts(index)
{
    const rules = index.groups.flatMap(v => v.rules);
    const sources = new Set(rules.map(v => v.source_path));
    const actual = {rules: rules.length, groups: index.groups.length, sources: sources.size};
    for (const key of Object.keys(actual)) {
        if (actual[key] !== index.stated[key]) {
            throw new Error(`rules.md states ${index.stated[key]} ${key}; the table holds ${actual[key]}`);
        }
    }
    for (const group of index.groups) {
        if (group.rules.length !== group.stated) {
            throw new Error(`rules.md states ${group.stated} rules for ${group.tag}; the table holds ${group.rules.length}`);
        }
    }
}

function html_from_index(template, index)
{
    const rules = index.groups.flatMap(v => v.rules);
    const values = {
        title: html_escape(index.title),
        lede: html_escape(index.lede),
        rules_count: String(rules.length),
        groups_count: String(index.groups.length),
        sources_count: String(new Set(rules.map(v => v.source_path)).size),
        groups_nav: index.groups.map(html_from_group_link).join(''),
        groups_main: index.groups.map(html_from_group).join(''),
    };
    return template_fill(template, values);
}

function template_fill(template, values)
{
    return template.replace(/\{\{(\w+)\}\}/g, function (match, key) {
        if (values[key] === undefined) {
            throw new Error(`template: unknown placeholder ${match}`);
        }
        return values[key];
    });
}

function html_from_group_link(group)
{
    return `<a href="#${group.tag}" data-group="${group.tag}"><span class="tag">${group.tag}</span><span class="name">${group.name}</span><span class="n">${group.rules.length}</span></a>\n`;
}

function html_from_group(group)
{
    const heading = `<h2><span class="tag">${group.tag}</span><span class="name">${group.name}</span><span class="note">${html_from_inline(group.note)}</span></h2>`;
    return `<section class="group" id="${group.tag}">\n${heading}\n${group.rules.map(html_from_rule).join('')}</section>\n`;
}

function html_from_rule(rule)
{
    const bare = (rule.form === '—');
    const source = `<a class="src" href="${blob_url}${rule.source_path}" title="${rule.source_path}">${rule.source_label}</a>`;
    const form = bare ? '' : html_from_form(rule.form) + '\n';
    return `<article class="rule${bare ? ' bare' : ''}" id="${rule.code}">\n`
        + `<a class="code" href="#${rule.code}">${rule.code}</a>\n`
        + `<div class="text"><p>${html_from_inline(rule.text)}</p>${source}</div>\n`
        + form
        + '</article>\n';
}

// A glossary: a "# Name (TAG)" title and its note, then terms, either
// directly or under "**Group** (TAG)" lines, each with its own note. A term
// is a table row or a "- term – definition" list item, and a "## Terms"
// section names a term whose paragraphs replace its one-line definition
// and whose code example stands on the right.
function glossary_from_markdown(markdown, file)
{
    const lines = markdown.split('\n');
    const title = lines[0].match(/^# (.+) \(([A-Z]+)\)$/);
    if (!title) {
        throw new Error(`${file}: the first line must be "# Name (TAG)"`);
    }
    const out = {file, name: title[1], tag: title[2], note: '', terms: [], groups: []};
    let owner = out;
    let item = null;
    let section = null;
    let paragraph = null;
    let code = null;
    for (const line of lines.slice(1)) {
        if (code) {
            if (line.startsWith('```')) {
                section.code = code;
                code = null;
            }
            else {
                code.push(line);
            }
            continue;
        }
        const group = line.match(/^\*\*(.+)\*\* \(([A-Z]+)\)$/);
        const heading = line.match(/^## (.+)$/);
        const bullet = line.match(/^- (.*)$/);
        if (line.trim() === '') {
            item = null;
            paragraph = null;
        }
        else if (group) {
            owner = {name: group[1], tag: group[2], note: '', terms: []};
            out.groups.push(owner);
        }
        else if (heading) {
            const name = heading[1].toLowerCase();
            section = out.terms.find(v => v.name.toLowerCase() === name || v.name.toLowerCase() + 's' === name);
            if (!section) {
                throw new Error(`${file}: "## ${heading[1]}" names no term`);
            }
        }
        else if (section && line.startsWith('```')) {
            code = [];
        }
        else if (section) {
            if (!paragraph) {
                paragraph = [];
                section.paragraphs.push(paragraph);
            }
            paragraph.push(line);
        }
        else if (line.startsWith('|')) {
            const cells = cells_from_row(line);
            if (cells[0] !== 'Term' && !cells.every(v => /^-+$/.test(v))) {
                owner.terms.push({name: cells[0], definition: cells[1], sentence: false, url: null, paragraphs: [], code: null});
            }
        }
        else if (bullet) {
            item = term_from_item(bullet[1]);
            owner.terms.push(item);
        }
        else if (item && /^\s/.test(line)) {
            item.definition += ' ' + line.trim();
        }
        else {
            owner.note += (owner.note ? ' ' : '') + line;
        }
    }
    return out;
}

// "[Term](url) – definition", "Term – definition" or a bare "Term".
function term_from_item(text)
{
    const link = text.match(/^\[([^\]]+)\]\((\S+?)\)(?: – (.*))?$/);
    if (link) {
        return {name: link[1], definition: link[3] ?? null, sentence: true, url: link[2], paragraphs: [], code: null};
    }
    const [name, ...rest] = text.split(' – ');
    return {name, definition: rest.length ? rest.join(' – ') : null, sentence: true, url: null, paragraphs: [], code: null};
}

function html_from_glossaries(template, glossaries)
{
    const groups = glossaries.flatMap(v => v.groups);
    const terms = glossaries.flatMap(v => [...v.terms, ...v.groups.flatMap(vv => vv.terms)]);
    const links = glossaries.map(v => `<a href="${blob_url}${v.file}">${path.basename(v.file)}</a>`);
    const values = {
        terms_count: String(terms.length),
        glossaries_count: String(glossaries.length),
        groups_count: String(groups.length),
        groups_nav: glossaries.map(html_from_glossary_links).join(''),
        groups_main: glossaries.map(html_from_glossary).join(''),
        glossary_links: links.join(', '),
    };
    return template_fill(template, values);
}

function html_from_glossary_links(glossary)
{
    const count = glossary.terms.length + glossary.groups.reduce((sum, v) => sum + v.terms.length, 0);
    let out = `<a href="#${glossary.tag}" data-group="${glossary.tag}"><span class="tag">${glossary.tag}</span><span class="name">${glossary.name}</span><span class="n">${count}</span></a>\n`;
    for (const group of glossary.groups) {
        out += `<a class="sub" href="#${group.tag}" data-group="${group.tag}"><span class="tag">${group.tag}</span><span class="name">${group.name}</span><span class="n">${group.terms.length}</span></a>\n`;
    }
    return out;
}

function html_from_glossary(glossary)
{
    const heading = `<h2><span class="tag">${glossary.tag}</span><span class="name">${glossary.name}</span><span class="note">${html_from_inline(glossary.note)}</span></h2>`;
    let out = `<section class="group" id="${glossary.tag}">\n${heading}\n`;
    out += html_from_terms(glossary.terms, glossary.tag, glossary.file);
    for (const group of glossary.groups) {
        const subheading = `<h3><span class="tag">${group.tag}</span><span class="name">${group.name}</span><span class="note">${html_from_inline(group.note)}</span></h3>`;
        out += `<section class="sub" id="${group.tag}">\n${subheading}\n${html_from_terms(group.terms, group.tag, glossary.file)}</section>\n`;
    }
    return out + '</section>\n';
}

function html_from_terms(terms, tag, file)
{
    let out = '';
    for (let i = 0, end = terms.length; i < end; ++i) {
        const term = terms[i];
        const code = tag + '-' + String(i + 1).padStart(2, '0');
        // A "## Term" section is the entry's full text and replaces the
        // one-line definition of the list.
        const definition = term.paragraphs.length ? null : format_term_definition(term);
        const details = term.paragraphs.map(v => `<p>${html_from_inline(v.join(' '))}</p>`).join('');
        const bare = !term.code;
        let sources = `<a class="src" href="${blob_url}${file}" title="${file}">${path.basename(file)}</a>`;
        if (term.url) {
            const host = new URL(term.url).hostname.split('.');
            sources += `<a class="src" href="${term.url}" title="${term.url.replace(/^https?:\/\//, '')}">${host[host.length - 2]}</a>`;
        }
        out += `<article class="rule${bare ? ' bare' : ''}" id="${code}">\n`
            + `<a class="code" href="#${code}">${code}</a>\n`
            + `<div class="text"><p><dfn>${html_from_inline(term.name)}</dfn></p>${definition ? `<p>${html_from_inline(definition)}</p>` : ''}${details}${sources}</div>\n`
            + (term.code ? html_from_lines(term.code.map(html_escape)) + '\n' : '')
            + '</article>\n';
    }
    return out;
}

// A list definition is written as a note; the page shows it as a sentence.
// A table definition is shown as written.
function format_term_definition(term)
{
    if (!term.definition || !term.sentence) {
        return term.definition;
    }
    const out = term.definition.charAt(0).toUpperCase() + term.definition.slice(1);
    return /[\p{L}\p{N}]$/u.test(out) ? out + '.' : out;
}

// A canonical form is a <pre> block, one code span, or prose. Code is shown
// byte for byte: <pre> keeps the entities rules.md already wrote.
function html_from_form(form)
{
    const pre = form.match(/^<pre>(.*)<\/pre>$/);
    if (pre) {
        return html_from_lines(pre[1].split('<br>'));
    }
    const code = form.match(/^`([^`]*)`$/);
    if (code) {
        return html_from_lines([html_escape(code[1])]);
    }
    const items = form.split('<br>');
    if (items.every(v => /^\d+\. /.test(v))) {
        const list = items.map(v => '<li>' + html_from_inline(v.replace(/^\d+\. /, '')) + '</li>').join('');
        return `<div class="form prose"><ol>${list}</ol></div>`;
    }
    return `<div class="form prose"><p>${html_from_inline(form)}</p></div>`;
}

function html_from_lines(lines)
{
    const code = lines.map(html_from_line).join('\n');
    return `<div class="form"><pre>${code}</pre><button class="copy" type="button">Copy</button></div>`;
}

// A comment or a verdict runs to the end of its line.
function html_from_line(line)
{
    const match = line.match(marker_regex);
    if (!match) {
        return line;
    }
    const start = match.index + match[1].length;
    return line.slice(0, start) + `<span class="${class_by_marker[match[2]]}">` + line.slice(start) + '</span>';
}

function html_from_inline(text)
{
    let out = '';
    for (const part of text.split(/(`[^`]+`)/)) {
        if (part.startsWith('`')) {
            out += '<code>' + html_escape(part.slice(1, -1)) + '</code>';
        }
        else {
            out += part.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
        }
    }
    return out;
}

function html_escape(text)
{
    return text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}

// Cells are split on unescaped pipes; \| inside a cell is a literal pipe.
function cells_from_row(line)
{
    return line.slice(1, -1).split(/(?<!\\)\|/).map(v => v.trim().replace(/\\\|/g, '|'));
}
